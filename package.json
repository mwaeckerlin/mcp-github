{
  "name": "@mwaeckerlin/mcp-github",
  "version": "1.1.1",
  "description": "Standalone secure MCP GitHub server with server-side authentication.",
  "main": "dist/server.js",
  "scripts": {
    "build": "docker compose build",
    "build:ts": "tsc -p tsconfig.json",
    "build:doc": "plantuml -tsvg -o doc README.md",
    "start": "docker compose up --build --force-recreate --remove-orphans",
    "start:daemon": "docker compose up -d --build --force-recreate --remove-orphans",
    "start:dev": "docker compose up --build --force-recreate --remove-orphans",
    "stop": "docker compose down",
    "deploy": "docker compose push",
    "dev": "tsx src/server.ts",
    "test": "npm run test:docs && npm run test:unit && npm run test:image && npm run test:e2e && npm run test:e2e:auth",
    "test:docs": "bash tests/docs-contract.sh",
    "test:unit": "tsx --test src/*.test.ts",
    "test:image": "npm run build && bash tests/image-contract.sh mwaeckerlin/mcp-github",
    "test:e2e": "(cd test && docker compose up --build --force-recreate --remove-orphans --abort-on-container-exit --exit-code-from test-client)",
    "test:e2e:auth": "(cd test && docker compose -f docker-compose.auth.yml up --build --force-recreate --remove-orphans --abort-on-container-exit --exit-code-from test-client-auth)"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwaeckerlin/mcp-github.git"
  },
  "keywords": [
    "mcp",
    "github",
    "security",
    "typescript"
  ],
  "author": "",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "bugs": {
    "url": "https://github.com/mwaeckerlin/mcp-github/issues"
  },
  "homepage": "https://github.com/mwaeckerlin/mcp-github#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/core": "^7.0.6",
    "@octokit/graphql": "^9.0.3",
    "@octokit/openapi": "^22.0.0",
    "@octokit/openapi-types": "^27.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
