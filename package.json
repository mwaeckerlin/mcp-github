{
  "name": "mcp-github",
  "version": "1.0.0",
  "description": "Standalone secure MCP GitHub server with server-side authentication.",
  "main": "dist/server.js",
  "scripts": {
    "test": "tsx --test src/**/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "docker compose up --build --force-recreate --remove-orphans",
    "build:docker": "docker compose build",
    "start:daemon": "docker compose up -d --build --force-recreate --remove-orphans"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mwaeckerlin/mcp-github.git"
  },
  "keywords": [
    "mcp",
    "github",
    "security",
    "typescript"
  ],
  "author": "",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "bugs": {
    "url": "https://github.com/mwaeckerlin/mcp-github/issues"
  },
  "homepage": "https://github.com/mwaeckerlin/mcp-github#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/core": "^7.0.6",
    "@octokit/graphql": "^9.0.3",
    "@octokit/openapi": "^22.0.0",
    "@octokit/openapi-types": "^27.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
